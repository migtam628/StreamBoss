# Secrets for MooBee. Copy to moobee.env (it is never committed) and fill in.
# TMDB "API Read Access Token" (the long one): https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=
# Only if you use MooBee's /upload page (needs your own MooBee Stream). Leave empty to switch it off.
# UPLOAD_PAGE_PASSWORD=
# UPLOAD_SESSION_SECRET=
# STREAM_ADMIN_API_KEY=
# STREAM_API_BASE_URL=
