# The name your devices will use, e.g. sync.example.com (its DNS must point at this machine).
SYNC_DOMAIN=sync.example.com
# first = only the first account can be created (the default; good for one person or one family)
# open  = anyone who can reach the server can create an account
# closed = no new accounts
REGISTRATION=first
# Where the web build of StreamBoss is hosted, if you use it (https://streamboss.example.com). * allows any.
ALLOWED_ORIGINS=*
# Only with docker-compose.moobee.yml: the name MooBee will be served on (its DNS must point at this machine too).
# MOOBEE_DOMAIN=moobee.example.com
# Only with docker-compose.web.yml: the website's name, and the folder on this machine its files live in.
# WEB_DOMAIN=streamboss.site
# WEB_ROOT=/srv/streamboss/web
# Use all the extra files with a plain "docker compose up -d --build":
# COMPOSE_FILE=docker-compose.yml:docker-compose.web.yml:docker-compose.moobee.yml
