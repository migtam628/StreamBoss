# The name your devices will use, e.g. sync.example.com (its DNS must point at this machine).
SYNC_DOMAIN=sync.example.com
# first = only the first account can be created (the default; good for one person or one family)
# open  = anyone who can reach the server can create an account
# closed = no new accounts
REGISTRATION=first
# Where the web build of StreamBoss is hosted, if you use it (https://streamboss.example.com). * allows any.
ALLOWED_ORIGINS=*
